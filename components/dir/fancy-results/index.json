{
  "type": "custom-component",
  "name": "fancy-results",
  "description": "## Fancy Results\nDisplays a list of items with fancy styling.",
  "children": [
    {
      "name": "div",
      "classList": [
        "fancy-container"
      ],
      "layout": {
        "container": {
          "type": "box",
          "orientation": "column"
        }
      },
      "children": [
        {
          "name": "div",
          "classList": [
            "fancy-item"
          ],
          "iterate": {
            "array": "$ctrl.items",
            "variable": "item"
          },
          "layout": {
            "cell": {
              "type": "box-item"
            }
          },
          "children": [
            {
              "name": "text",
              "textContent": "item.name",
              "evaluate": true
            }
          ]
        }
      ]
    }
  ],
  "variables": [],
  "bindings": [
