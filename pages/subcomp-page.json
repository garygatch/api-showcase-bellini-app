{
  "name": "subcomp-page",
  "type": "page",
  "url": "/subcomp-page",
  "params": {},
  "variables": [
    {
      "name": "$state",
      "type": "service"
    },
    {
      "name": "countriesApi",
      "type": "graphql-api",
      "id": "graphql-api"
    },
    {
      "name": "continents",
      "description": "List of continents fetched from the GraphQL API.",
      "type": "property",
      "value": "[]"
    },
    {
      "name": "isLoading",
      "description": "Loading state flag.",
      "type": "property",
      "value": "false"
    },
    {
      "name": "loadError",
      "description": "Error message if the API fetch fails.",
      "type": "property",
      "value": "null"
    },
    {
      "name": "loadContinents",
      "description": "Fetches continents with their names and codes from the countriesApi.",
      "type": "method",
      "body": "$ctrl.isLoading = true;\n$ctrl.loadError = null;\ntry {\n  const items = await $ctrl.countriesApi.query.continents({}, { code: true, name: true });\n  $ctrl.continents = items;\n} catch (err) {\n  $ctrl.loadError = (err && err.message) || 'Failed to load continents.';\n} finally {\n  $ctrl.isLoading = false;\n}",
      "invokeOnLoad": true,
      "isAsync": true,
      "returnType": {
        "name": "any"
      },
      "parameters": [],
      "watch": []
    },
    {
      "name": "goHome",
      "description": "Navigates back to the home page.",
      "type": "method",
      "body": "$ctrl.$state.go('home');",
      "invokeOnLoad": false,
      "isAsync": false,
      "returnType": {
        "name": "any"
      },
      "parameters": [],
      "watch": []
    }
  ],
