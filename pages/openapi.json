{
  "name": "openapi",
  "type": "page",
  "url": "/openapi",
  "params": {},
  "variables": [
    {
      "name": "$state",
      "type": "service"
    },
    {
      "name": "petstoreApi",
      "type": "open-api",
      "id": "open-api"
    },
    {
      "name": "pets",
      "description": "Stores the list of pets returned from the API.",
      "type": "property",
      "value": "[]"
    },
    {
      "name": "isLoading",
      "description": "Tracks the loading state of the API call.",
      "type": "property",
      "value": "false"
    },
    {
      "name": "errorMessage",
      "description": "Stores any error message encountered during the API call.",
      "type": "property",
      "value": "null"
    },
    {
      "name": "loadPets",
      "description": "Fetches available pets from the API and updates the state.",
      "type": "method",
      "body": "$ctrl.isLoading = true;\n$ctrl.errorMessage = null;\ntry {\n  const response = await $ctrl.petstoreApi.findPetsByStatus({ status: ['available'] });\n  $ctrl.pets = response.data || [];\n} catch (err) {\n  $ctrl.errorMessage = (err && err.data && err.data.message) || 'Failed to load pets.';\n  $ctrl.pets = [];\n} finally {\n  $ctrl.isLoading = false;\n}",
      "invokeOnLoad": true,
      "isAsync": true,
      "returnType": {
        "name": "any"
      },
      "parameters": [],
      "watch": []
    },
    {
      "name": "goHome",
      "description": "Navigates back to the home page.",
      "type": "method",
      "body": "$ctrl.$state.go('home');",
      "invokeOnLoad": false,
      "isAsync": false,
      "returnType": {
        "name": "any"
      },
      "parameters": [],
      "watch": []
    }
  ],
